# Verplicht
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=123456:ABC...
# Alleen deze Telegram-gebruikers-ID's mogen de bot gebruiken (komma-gescheiden).
# Stuur /start naar de bot om je ID te zien.
ALLOWED_USER_IDS=

# Optioneel
TIMEZONE=Europe/Amsterdam
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
DATA_DIR=./data

# Outlook (Microsoft Graph): Application (client) ID van je Azure app-registratie
MS_CLIENT_ID=
MS_TENANT=consumers

# Spraakberichten: whisper-model (tiny/base/small/medium) en taal (leeg = automatisch)
WHISPER_MODEL=small
WHISPER_LANGUAGE=nl

# Snelkoppeling (Siri / Android): kies een lange willekeurige sleutel, bijv. via
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leeg laten = snelkoppeling-API uit.
API_TOKEN=
API_HOST=0.0.0.0
API_PORT=8080

# Spraakantwoorden: auto (terugpraten als jij inspreekt), aan (altijd), uit. Per chat te wijzigen met /stem
VOICE_REPLIES=auto
# Stem: nl-NL-ColetteNeural, nl-NL-MaartenNeural, nl-NL-FennaNeural, nl-BE-DenaNeural, nl-BE-ArnaudNeural
TTS_VOICE=nl-NL-ColetteNeural

# Ochtendoverzicht: standaardtijdstip (of 'uit'). Per chat te wijzigen met /ochtend
BRIEFING_TIME=07:30
