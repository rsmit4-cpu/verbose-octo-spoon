# Verplicht
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp Business Cloud API (developers.facebook.com -> jouw app -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App-instellingen -> Basis -> App-geheim (om te controleren dat berichten echt van Meta komen)
WHATSAPP_APP_SECRET=
# Zelf verzonnen wachtwoord; vul hetzelfde in bij het instellen van de webhook
WHATSAPP_VERIFY_TOKEN=
# Jouw eigen WhatsApp-nummer(s) met landcode; alleen deze mogen de assistent gebruiken. Eerste = eigenaar.
ALLOWED_NUMBERS=+31612345678
# Optioneel: goedgekeurd sjabloon voor herinneringen na >24 uur stilte (zie README)
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=nl

# Optioneel
TIMEZONE=Europe/Amsterdam
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
DATA_DIR=./data

# Outlook (Microsoft Graph): Application (client) ID van je Azure app-registratie
MS_CLIENT_ID=
MS_TENANT=consumers

# Spraakberichten: whisper-model (tiny/base/small/medium) en taal (leeg = automatisch)
WHISPER_MODEL=small
WHISPER_LANGUAGE=nl

# Poort van de server (webhook + snelkoppeling)
# Snelkoppeling (Siri / Android): kies een lange willekeurige sleutel, bijv. via
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leeg laten = snelkoppeling-API uit.
API_TOKEN=
API_HOST=0.0.0.0
API_PORT=8080
